{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gyc567/AuraBrowser/skills/loop-minimal-fix/output-schema.json",
  "title": "loop-minimal-fix output",
  "type": "object",
  "required": ["task_id", "files_changed", "lines_added", "lines_removed", "test_passed", "verdict"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string" },
    "files_changed": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "lines_added": { "type": "integer", "minimum": 0, "maximum": 50 },
    "lines_removed": { "type": "integer", "minimum": 0, "maximum": 50 },
    "test_passed": { "type": "boolean" },
    "verdict": { "enum": ["OK", "ESCALATE", "BLOCKED"] },
    "operator_count": { "type": "integer", "minimum": 0 },
    "time_seconds": { "type": "integer", "minimum": 0 },
    "notes": { "type": "string", "maxLength": 500 }
  }
}
