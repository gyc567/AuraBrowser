{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gyc567/AuraBrowser/skills/loop-verifier/output-schema.json",
  "title": "loop-verifier output",
  "type": "object",
  "required": ["task_id", "verdict", "reasons", "score", "evidence"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string" },
    "verdict": { "enum": ["PASS", "FAIL", "ESCALATE"] },
    "reasons": {
      "type": "array",
      "minItems": 0,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "evidence": {
      "type": "object",
      "required": ["tests_run", "tests_passed", "denylist_touched"],
      "additionalProperties": false,
      "properties": {
        "tests_run": { "type": "integer", "minimum": 0 },
        "tests_passed": { "type": "integer", "minimum": 0 },
        "coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "denylist_touched": { "type": "boolean" },
        "denylist_files": { "type": "array", "items": { "type": "string" } },
        "console_log_residue": { "type": "boolean" },
        "test_new_branches_covered": { "type": "boolean" }
      }
    },
    "operator_count": { "type": "integer", "minimum": 0 },
    "time_seconds": { "type": "integer", "minimum": 0 }
  }
}
