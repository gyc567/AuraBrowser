{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gyc567/AuraBrowser/skills/loop-triage/output-schema.json",
  "title": "loop-triage output",
  "type": "object",
  "required": ["timestamp", "summary", "high_priority", "watch", "escalations"],
  "additionalProperties": false,
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "high_priority": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "score", "category"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "category": { "enum": ["refactor", "test", "doc", "security", "perf", "infra"] },
          "files_touched_estimate": { "type": "integer", "minimum": 1, "maximum": 8 }
        }
      }
    },
    "watch": {
      "type": "array",
      "items": { "type": "string", "maxLength": 200 }
    },
    "escalations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "reason": { "type": "string" },
          "context": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
